# ─────────────────────────────────────────────────────────
# STARINC Frontend — PRODUCTION (.env.production)
# Target: dibuild DI VPS sebagai static asset, dilayani Nginx
#
# ⚠️  PENTING: Vite EMBED env vars saat build-time.
#     Build harus dijalankan DI VPS dengan file ini sebagai
#     .env.production — JANGAN build di laptop lalu upload dist/,
#     karena nilai localhost akan terbawa.
# ─────────────────────────────────────────────────────────

# URL backend API (WAJIB https, tanpa trailing slash)
VITE_API_URL=https://api.starincofficial.id/api

# URL storage publik Laravel (untuk gambar produk, dll)
VITE_STORAGE_URL=https://api.starincofficial.id/storage

# Midtrans CLIENT key (production, bukan sandbox)
VITE_MIDTRANS_CLIENT_KEY=Mid-client-GANTI
VITE_MIDTRANS_IS_PRODUCTION=true
