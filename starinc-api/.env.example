APP_NAME=Starinc
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database (Railway MySQL addon — copy values from Railway dashboard) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Frontend URL (Vercel deployment URL, no trailing slash) ---
FRONTEND_URL=https://your-app.vercel.app

# --- Sanctum (same as FRONTEND_URL host) ---
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app

# --- Mail (optional for testing, leave as log to skip) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@starinc.com"
MAIL_FROM_NAME="Starinc"

# --- Midtrans (isi jika payment gateway aktif) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# --- Media Storage ---
# Driver default untuk upload baru: 'local' atau 'cloudinary'
MEDIA_DEFAULT_DRIVER=local

# Cloudinary credentials (dari dashboard cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
