# ─────────────────────────────────────────────────────────
# STARINC Backend — PRODUCTION (.env)
# Target: VPS Ubuntu 24.04 + Nginx + MySQL + Cloudflare
# Copy ke .env lalu isi nilai yang ditandai GANTI_*
# ─────────────────────────────────────────────────────────

APP_NAME=STARINC
APP_ENV=production
APP_KEY=                                    # generate via: php artisan key:generate
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://api.starincofficial.id      # WAJIB pakai https, tanpa trailing slash

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ─── Logging ─────────────────────────────────────────────
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ─── Database (MySQL lokal di VPS) ───────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=starinc_db_v2
DB_USERNAME=starinc
DB_PASSWORD=GANTI_PASSWORD_DB

# ─── Session / Cache / Queue ─────────────────────────────
# Pakai database driver dulu (sudah ter-install). Bisa migrate ke redis nanti.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.starincofficial.id           # leading-dot biar berlaku untuk subdomain juga

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# ─── Frontend URL (untuk link di email & redirect) ───────
FRONTEND_URL=https://starincofficial.id

# ─── Sanctum (frontend stateless pakai Bearer token, ini cuma fallback) ──
SANCTUM_STATEFUL_DOMAINS=starincofficial.id,www.starincofficial.id

# ─── Mail (Resend) ───────────────────────────────────────
MAIL_MAILER=resend
RESEND_API_KEY=re_GANTI_DARI_DASHBOARD_RESEND
MAIL_FROM_ADDRESS="noreply@starincofficial.id"
MAIL_FROM_NAME="STARINC"

# Midtrans tidak dipakai (kode masih ada tapi tidak terhubung ke route)

# ─── Media Storage ───────────────────────────────────────
# Production: pakai 'cloudinary' untuk CDN delivery global
MEDIA_DEFAULT_DRIVER=cloudinary

CLOUDINARY_CLOUD_NAME=GANTI
CLOUDINARY_API_KEY=GANTI
CLOUDINARY_API_SECRET=GANTI
CLOUDINARY_URL=cloudinary://GANTI
